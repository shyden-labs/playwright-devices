2026-11-22T20:36:58.5845890Z   let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => {
2026-11-22T20:36:58.5846300Z     const { devices } = JSON.parse(s);
2026-11-22T20:36:58.5847190Z     const found = (devices[process.env.RUNTIME] ?? []).find((d) => d.name === process.env.DEVICE);
2026-11-22T20:36:58.5847830Z     if (!found) {
2026-11-22T20:36:58.5848530Z       const where = Object.entries(devices).filter(([, list]) => list.some((d) => d.name === process.env.DEVICE)).map(([k]) => k);
2026-11-22T20:36:58.5849400Z       console.error(`no ${process.env.DEVICE} on ${process.env.RUNTIME}; it is on: ${where.join(", ") || "no runtime"}`);
2026-11-22T20:36:58.5849870Z       process.exit(1);
2026-11-22T20:36:58.5850410Z     }
2026-11-22T20:36:58.5850660Z     console.log(found.udid);
2026-11-22T20:36:58.5850940Z   });')
2026-11-22T20:36:58.5851330Z echo "udid=$udid" >> "$GITHUB_OUTPUT"
2026-11-22T20:36:58.5851830Z # Memory and disk every 30 s while it boots, with the five processes holding most memory: run
2026-11-22T20:36:58.5852540Z # 45064693169's iPad mini boot hung as free memory fell from 60% to 13% (#46), with nothing else running.
2026-11-22T20:36:58.5853640Z ( while :; do echo "resources: $(memory_pressure -Q | tail -1); $(df -h / | awk 'NR==2 {print $4 " free on /"}'); top: $(top -l 1 -o mem -n 5 -stats command,mem | tail -5 | tr -s ' ' | tr '\n' ',')"; sleep 30; done ) &
2026-11-22T20:36:58.5854370Z monitor=$!
2026-11-22T20:36:58.5854730Z xcrun simctl boot "$udid"
2026-11-22T20:36:58.5855040Z xcrun simctl bootstatus "$udid" -b
2026-11-22T20:36:58.5855410Z kill $monitor
