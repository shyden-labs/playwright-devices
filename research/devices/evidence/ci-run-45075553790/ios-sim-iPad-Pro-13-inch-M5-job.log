2026-11-22T22:04:34.1800800Z   let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => {
2026-11-22T22:04:34.1801870Z     const { devices } = JSON.parse(s);
2026-11-22T22:04:34.1803130Z     const found = (devices[process.env.RUNTIME] ?? []).find((d) => d.name === process.env.DEVICE);
2026-11-22T22:04:34.1804280Z     if (!found) {
2026-11-22T22:04:34.1805760Z       const where = Object.entries(devices).filter(([, list]) => list.some((d) => d.name === process.env.DEVICE)).map(([k]) => k);
2026-11-22T22:04:34.1807940Z       console.error(`no ${process.env.DEVICE} on ${process.env.RUNTIME}; it is on: ${where.join(", ") || "no runtime"}`);
2026-11-22T22:04:34.1809500Z       process.exit(1);
2026-11-22T22:04:34.1810600Z     }
2026-11-22T22:04:34.1811320Z     console.log(found.udid);
2026-11-22T22:04:34.1812020Z   });')
2026-11-22T22:04:34.1812750Z echo "udid=$udid" >> "$GITHUB_OUTPUT"
2026-11-22T22:04:34.1814100Z # Memory and disk every 30 s while it boots, with the five processes holding most memory: run
2026-11-22T22:04:34.1815720Z # 45064693169's iPad mini boot hung as free memory fell from 60% to 13% (#46), with nothing else running.
2026-11-22T22:04:34.1818160Z ( while :; do echo "resources: $(memory_pressure -Q | tail -1); $(df -h / | awk 'NR==2 {print $4 " free on /"}'); top: $(top -l 1 -o mem -n 5 -stats command,mem | tail -5 | tr -s ' ' | tr '\n' ',')"; sleep 30; done ) &
2026-11-22T22:04:34.1820240Z monitor=$!
2026-11-22T22:04:34.1820840Z xcrun simctl boot "$udid"
2026-11-22T22:04:34.1821690Z xcrun simctl bootstatus "$udid" -b
2026-11-22T22:04:34.1822550Z kill $monitor
