{
  "name": "@shyden-labs/playwright-devices",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/one-suite/check.d.ts",
      "default": "./dist/src/one-suite/check.js"
    },
    "./assertion-counter": {
      "types": "./dist/src/one-suite/assertion-counter.d.ts",
      "default": "./dist/src/one-suite/assertion-counter.js"
    },
    "./desktop": {
      "types": "./dist/src/desktop/browsers.d.ts",
      "default": "./dist/src/desktop/browsers.js"
    }
  },
  "bin": {
    "one-suite": "./dist/src/one-suite/cli.js"
  },
  "files": [
    "dist/",
    "NOTICE"
  ],
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage.enabled",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build && if [ -e .git ]; then git config core.hooksPath .githooks; fi",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@playwright/test": "^1.65.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "fsevents": false
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
